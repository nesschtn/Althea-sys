terraform {
  required_version = ">= 1.6.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  backend "azurerm" {
    # Values injected at init time via -backend-config
    # See bootstrap/ to provision the storage account
  }
}

provider "azurerm" {
  features {}
}
